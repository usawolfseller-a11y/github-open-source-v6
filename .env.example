# Copy names only. Real values belong in GitHub Secrets/Variables — never in git.
#
# Rule of thumb: SECRETS (below the first divider) go to Settings -> Secrets.
# Everything else is a VARIABLE (Settings -> Variables) and is safe to read.
# The full setup order is in docs/RUNBOOK.md.

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------
APP_ENV=test
PUBLISH_TARGET=test

# Test channel numeric id. If empty, publishing fails closed - it never falls
# back to the main channel.
TELEGRAM_TEST_CHANNEL_ID=
# Only used when APP_ENV=production and PUBLISH_TARGET=main.
TELEGRAM_MAIN_CHANNEL_ID=
# Legacy alias still read by config.py. Prefer the canonical name above.
MAIN_TELEGRAM_CHANNEL=
# Where owner reports and alerts go.
TELEGRAM_OWNER_CHAT_ID=
# Comma-separated public channels used as discovery sources.
TELEGRAM_SOURCE_CHANNELS=

GEMINI_MODEL=gemini-3.5-flash-lite

BLUESKY_HANDLE=
MASTODON_INSTANCE_URL=https://mastodon.social
FACEBOOK_PAGE_ID=
FACEBOOK_SHEETS_ID=
FACEBOOK_SHEETS_RANGE=Posts!A1:E1

# Feature flags. Enable ONE at a time after the acceptance checklist.
# FEATURE_FACEBOOK is the canonical spelling. The legacy FEATURE_Facebook
# spelling is still read so an existing environment does not silently turn
# Facebook crossposts off, but do not use it in new setups.
FEATURE_TELEGRAPH=true
FEATURE_DEVTO=false
FEATURE_BLUESKY=false
FEATURE_MASTODON=false
FEATURE_FACEBOOK=false
FEATURE_AI_BRIEF=false
FEATURE_SHEETS_HANDOFF=false

# Optional overrides, mostly for local runs.
GITHUB_REPOSITORY=
GHOS_GITHUB_REPOSITORY=
GHOS_STATE_DIR=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# In GitHub Actions GH_API_TOKEN is mapped from the built-in github.token.
# Locally, use a personal token with public repo read scope.
GH_API_TOKEN=
GITHUB_TOKEN=

GEMINI_API_KEY=
IMGBB_API_KEY=
TELEGRAPH_ACCESS_TOKEN=

DEV_API_KEY=
BLUESKY_APP_PASSWORD=
MASTODON_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Service-account JSON for the make.com sheet hand-off, as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
